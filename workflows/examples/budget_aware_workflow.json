{
  "workflow_id": "wf_budget_aware_001",
  "name": "Budget-Aware Research Workflow",
  "description": "Adapts strategy based on available budget",
  "created_by": "system",
  "created_at": "2026-02-12T00:00:00Z",
  "status": "draft",

  "input_schema": {
    "type": "object",
    "required": ["question", "budget"],
    "properties": {
      "question": {"type": "string"},
      "budget": {"type": "number"}
    }
  },

  "output_schema": {
    "type": "object",
    "properties": {
      "answer": {"type": "string"},
      "strategy_used": {"type": "string"}
    }
  },

  "steps": [
    {
      "step_id": "step_01_cheap_facts",
      "name": "Get Cheap Facts",
      "description": "Get facts from Wikipedia (cheap)",
      "operation": "get_article_summary",
      "executor": "discover",
      "discovery_query": {
        "operation": "get_article_summary",
        "selection_criteria": "cheapest"
      },
      "depends_on": [],
      "input_mapping": {
        "topic": "workflow.input.question"
      },
      "on_failure": "abort",
      "cost_limit": 0.05
    },

    {
      "step_id": "step_02_expensive_papers",
      "name": "Get Scientific Papers (Expensive)",
      "description": "Get papers from ArXiv - only if budget allows",
      "operation": "search_papers",
      "executor": "discover",
      "discovery_query": {
        "operation": "search_papers",
        "selection_criteria": "balanced"
      },
      "depends_on": ["step_01_cheap_facts"],
      "input_mapping": {
        "query": "workflow.input.question"
      },
      "on_failure": "continue",
      "cost_limit": 0.05
    },

    {
      "step_id": "step_03_cheap_synthesis",
      "name": "Cheap Synthesis",
      "description": "Basic synthesis with cheap LLM",
      "operation": "synthesize_text",
      "executor": "discover",
      "discovery_query": {
        "operation": "synthesize_text",
        "selection_criteria": "cheapest"
      },
      "depends_on": ["step_01_cheap_facts"],
      "input_mapping": {
        "sources": [
          "step_01_cheap_facts.result",
          "step_02_expensive_papers.result"
        ],
        "question": "workflow.input.question"
      },
      "on_failure": "fallback",
      "fallback_step": "step_04_no_synthesis"
    },

    {
      "step_id": "step_04_no_synthesis",
      "name": "No Synthesis (Ultra Cheap)",
      "description": "Just return raw facts if no budget for synthesis",
      "operation": "format_raw_data",
      "executor": "self",
      "depends_on": [],
      "input_mapping": {
        "data": "step_01_cheap_facts.result"
      },
      "on_failure": "abort"
    }
  ]
}
