pythonfrom shared.execution_trace import ExecutionTracer, TraceEvent


class aFDOBase(ABC):
    """
    Enhanced with execution tracing.
    
    Every request gets a tracer that captures all interactions.
    """
    
    def __init__(self, ...):
        # ... existing init ...
        
        # Trace directory
        self.trace_directory = os.getenv("TRACE_DIRECTORY", "/tmp/afdo_traces")
    
    async def handle_doip_request(
        self,
        operation: str,
        parameters: Dict[str, Any]
    ) -> Dict[str, Any]:
        """
        Enhanced with execution tracing.
        
        Every request creates a trace.
        """
        
        # Create tracer for this request
        tracer = ExecutionTracer(
            user_query=parameters.get("message", operation)
        )
        
        # Log initial receipt
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="receive",
            operation=operation,
            input_data=parameters,
            notes="Request received"
        )
        
        try:
            # Execute with tracing
            result = await self._execute_with_tracing(
                operation=operation,
                parameters=parameters,
                tracer=tracer
            )
            
            # Log final return
            tracer.log_event(
                agent_name=self.name,
                agent_pid=self.pid,
                action_type="return",
                operation=operation,
                output_data=result,
                notes="Request completed successfully"
            )
            
            # Save trace
            trace_file = tracer.save_to_file(self.trace_directory)
            
            # Add trace info to result
            result["_trace"] = {
                "request_id": tracer.request_id,
                "trace_file": trace_file,
                "summary": tracer.get_summary()
            }
            
            return result
        
        except Exception as e:
            # Log error
            tracer.log_event(
                agent_name=self.name,
                agent_pid=self.pid,
                action_type="error",
                operation=operation,
                error=str(e),
                notes="Request failed"
            )
            
            # Save trace even on error
            trace_file = tracer.save_to_file(self.trace_directory)
            
            raise
    
    async def _execute_with_tracing(
        self,
        operation: str,
        parameters: Dict[str, Any],
        tracer: ExecutionTracer
    ) -> Dict[str, Any]:
        """
        Execute operation with tracing.
        
        This is where we capture policy evaluation, delegation, etc.
        """
        
        start_time = datetime.utcnow()
        
        # Policy evaluation with tracing
        if self.policy_engine:
            decision = await self._evaluate_policy_with_tracing(
                operation=operation,
                parameters=parameters,
                tracer=tracer
            )
        else:
            decision = PolicyDecision(
                decision=DecisionType.HANDLE_ALONE,
                reasoning="No policy engine",
                rule_id="default"
            )
        
        # Execute decision with tracing
        result = await self._execute_decision_with_tracing(
            decision=decision,
            operation=operation,
            parameters=parameters,
            tracer=tracer
        )
        
        duration = (datetime.utcnow() - start_time).total_seconds() * 1000
        
        # Log execution
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="execute",
            operation=operation,
            duration_ms=int(duration),
            notes=f"Executed with policy decision: {decision.decision.value}"
        )
        
        return result
    
    async def _evaluate_policy_with_tracing(
        self,
        operation: str,
        parameters: Dict[str, Any],
        tracer: ExecutionTracer
    ) -> PolicyDecision:
        """
        Evaluate policy with tracing.
        """
        
        start_time = datetime.utcnow()
        
        decision = await self.policy_engine.decide(
            operation=operation,
            parameters=parameters
        )
        
        duration = (datetime.utcnow() - start_time).total_seconds() * 1000
        
        # Log policy evaluation
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="policy_evaluation",
            operation="evaluate_policy",
            input_data={"operation": operation},
            output_data={"decision": decision.decision.value},
            duration_ms=int(duration),
            policy_rule=decision.rule_id,
            policy_reasoning=decision.reasoning,
            notes=f"Policy matched rule: {decision.rule_id}"
        )
        
        return decision
    
    async def _execute_decision_with_tracing(
        self,
        decision: PolicyDecision,
        operation: str,
        parameters: Dict[str, Any],
        tracer: ExecutionTracer
    ) -> Dict[str, Any]:
        """
        Execute policy decision with tracing.
        """
        
        if decision.decision == DecisionType.HANDLE_ALONE:
            return await self._execute_operation(operation, parameters)
        
        elif decision.decision == DecisionType.QUERY_REGISTRY_FOR_HELPER:
            return await self._delegate_with_tracing(
                decision=decision,
                operation=operation,
                parameters=parameters,
                tracer=tracer
            )
        
        elif decision.decision == DecisionType.DECOMPOSE_AND_COORDINATE:
            return await self._decompose_with_tracing(
                decision=decision,
                operation=operation,
                parameters=parameters,
                tracer=tracer
            )
        
        else:
            return await self._execute_operation(operation, parameters)
    
    async def _delegate_with_tracing(
        self,
        decision: PolicyDecision,
        operation: str,
        parameters: Dict[str, Any],
        tracer: ExecutionTracer
    ) -> Dict[str, Any]:
        """
        Delegate to helper with tracing.
        """
        
        # Discover helpers
        registry_query = decision.parameters.get("registry_query", {})
        operations_to_find = registry_query.get("operations", [])
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="discover",
            operation="query_registry",
            input_data={"operations": operations_to_find},
            notes="Discovering agents from registry"
        )
        
        # Find helpers
        helpers = []
        for op in operations_to_find:
            found = await self.discover_by_operation(op)
            if found:
                helpers = found
                break
        
        if not helpers:
            tracer.log_event(
                agent_name=self.name,
                agent_pid=self.pid,
                action_type="discover",
                operation="query_registry",
                output_data={"found": 0},
                notes="No agents found - executing fallback"
            )
            
            if decision.fallback:
                return await self._execute_fallback(decision.fallback, operation, parameters)
            raise ValueError("No agents found")
        
        # Select helper
        selected = self._select_helper(helpers, "cheapest")
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="select",
            operation="select_helper",
            output_data={"selected": selected["name"], "cost": selected["cost"]},
            notes=f"Selected {selected['name']} from {len(helpers)} candidates"
        )
        
        # Prepare input (schema-driven)
        prepared_params = await self._prepare_input_for_delegee(
            user_query=parameters.get("message", ""),
            delegee_pid=selected["pid"],
            delegee_name=selected["name"],
            operation=operation
        )
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="prepare_input",
            operation="prepare_for_delegee",
            input_data={"original": parameters.get("message", "")[:100]},
            output_data={"prepared": str(prepared_params)[:100]},
            notes="Prepared input based on delegee's schema"
        )
        
        # Delegate
        start_time = datetime.utcnow()
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="delegate",
            operation=operation,
            input_data=prepared_params,
            delegated_to=selected["name"],
            delegated_to_pid=selected["pid"],
            cost=selected["cost"],
            notes=f"Delegating to {selected['name']}"
        )
        
        result = await self.call_other_afdo(
            target_pid=selected["pid"],
            operation=operation,
            data=prepared_params
        )
        
        duration = (datetime.utcnow() - start_time).total_seconds() * 1000
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="receive_result",
            operation=operation,
            output_data=result,
            duration_ms=int(duration),
            delegated_to=selected["name"],
            notes=f"Received result from {selected['name']}"
        )
        
        return result
    
    async def _decompose_with_tracing(
        self,
        decision: PolicyDecision,
        operation: str,
        parameters: Dict[str, Any],
        tracer: ExecutionTracer
    ) -> Dict[str, Any]:
        """
        Decompose and coordinate with tracing.
        """
        
        # Plan subtasks
        subtasks = await self._plan_subtasks(
            operation=operation,
            parameters=parameters,
            delegate_types=decision.parameters.get("delegate", [])
        )
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="plan",
            operation="plan_subtasks",
            output_data={"subtask_count": len(subtasks)},
            notes=f"Planned {len(subtasks)} subtasks"
        )
        
        # Execute each subtask
        subtask_results = []
        
        for i, subtask in enumerate(subtasks, 1):
            tracer.log_event(
                agent_name=self.name,
                agent_pid=self.pid,
                action_type="subtask_start",
                operation=subtask.get("operation"),
                input_data=subtask.get("parameters"),
                notes=f"Starting subtask {i}/{len(subtasks)}: {subtask.get('description')}"
            )
            
            # Discover and delegate (similar to above, with tracing)
            # ... (delegate with tracing for each subtask)
            
            subtask_results.append(result)
        
        # Compose results
        final_result = await self._compose_results(
            operation=operation,
            original_parameters=parameters,
            subtask_results=subtask_results
        )
        
        tracer.log_event(
            agent_name=self.name,
            agent_pid=self.pid,
            action_type="compose",
            operation="compose_results",
            output_data={"result_preview": str(final_result)[:100]},
            notes=f"Composed final result from {len(subtask_results)} subtasks"
        )
        
        return final_result

